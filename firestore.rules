rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user exists in the user collection
    function isAuthorizedUser() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/user/$(request.auth.uid));
    }

    // User collection - users can only read their own document
    // Only you can create/delete users via Firebase Console
    match /user/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if false; // Only admin can modify via console
    }

    // Daily docs collection - users can only access their own documents
    match /dailyDocs/{dateStr} {
      allow read, write: if isAuthorizedUser();
    }

    // Quotes collection - read-only for authenticated users
    match /quotes/{quoteId} {
      allow read: if isAuthorizedUser();
      allow write: if false; // Only admin via console
    }

    // FCM Tokens collection - users can manage their own tokens
    match /fcmTokens/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
